{
  "name": "alboe",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/alboe-development/alboe.git"
  },
  "license": "MIT",
  "workspaces": [
    "modules/**/*"
  ],
  "scripts": {
    "@all": "pnpm --recursive --if-present",
    "@app": "pnpm --filter \"*app*\" --if-present",
    "@config": "pnpm --filter \"*config*\" --if-present",
    "@design": "pnpm --filter \"*design*\" --if-present",
    "@game": "pnpm --filter \"*game*\" --if-present",
    "@tools": "pnpm --filter \"*config*\" --if-present",
    "@project:dependencies:update": "pnpm update --lockfile-only --no-save --recursive"
  },
  "devDependencies": {
    "@alboe/eslint-config": "workspace:*",
    "eslint": "catalog:"
  }
}
